<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Ask.Text.Large.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="@string/setup_wizard_step_permissions_title"
            android:textSize="22sp" />

        <ImageView
            android:id="@+id/step_state_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/setup_wizard_step_permissions_title"
            android:scaleType="centerInside"
            android:src="@drawable/ic_permissions_wizard_state" />

        <!-- Contacts Permission Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/contacts_permission_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/app_card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/ask_for_contact_permissions_action"
                    style="@style/Ask.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_contacts_perm_required"
                    android:drawableLeft="@drawable/ic_contacts_perm_required"
                    android:drawablePadding="10dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/wizard_allow_contacts_permission"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    style="@style/Ask.Text.Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/contacts_permissions_rationale"
                    android:textColor="?android:textColorSecondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/open_permissions_wiki_action"
                        style="@style/Ask.Text.Link.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/transparent_click_feedback_background"
                        android:padding="8dp"
                        android:text="@string/read_more_about_permissions" />

                    <TextView
                        android:id="@+id/disable_contacts_dictionary"
                        style="@style/Ask.Text.Link.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/transparent_click_feedback_background"
                        android:padding="8dp"
                        android:text="@string/turn_off_contacts_dictionary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notification Permission Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/notification_permission_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/app_card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/ask_for_notification_permissions_action"
                    style="@style/Ask.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_notification_perm_required"
                    android:drawableLeft="@drawable/ic_notification_perm_required"
                    android:drawablePadding="10dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="@string/wizard_allow_notification_permission"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    style="@style/Ask.Text.Normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_wizard_step_notification_permissions_details"
                    android:textColor="?android:textColorSecondary" />

                <TextView
                    android:id="@+id/skip_notification_permissions_action"
                    style="@style/Ask.Text.Link.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/transparent_click_feedback_background"
                    android:padding="8dp"
                    android:text="@string/wizard_skip_notification_permission" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/skip_setup_wizard"
            style="@style/Ask.Text.Link.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:background="@drawable/transparent_click_feedback_background"
            android:padding="8dp"
            android:text="@string/setup_wizard_skip" />
    </LinearLayout>
</ScrollView>
